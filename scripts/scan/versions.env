# The supply-chain tools, pinned. One place for every version and checksum: CI installs exactly these
# (scripts/scan/install.sh). Every version was at least 14 days old when pinned. Moving one: change it here with the
# checksum from the release's own checksum file (osv-scanner_SHA256SUMS, syft_<v>_checksums.txt), then run
# `bash scripts/scan/osv.sh` and `bash scripts/scan/sbom.sh`. Same pins as app-template, stack and the GreenWay App Factory's scanner gate.

# OSV-Scanner (Google, Apache-2.0): known vulnerabilities in uv.lock, against a local copy of the OSV database
# (--offline-vulnerabilities): the package list never leaves the machine.
OSV_VERSION=2.7.1
OSV_SHA256_LINUX_AMD64=fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8
OSV_SHA256_DARWIN_ARM64=b22c02877a811c8f78956e8643efa554932b7378f590d13f8e97d4e9448a29f3

# Syft (Anchore, Apache-2.0): the CycloneDX SBOM. Reads uv.lock (python-package-cataloger).
SYFT_VERSION=1.57.1
SYFT_SHA256_LINUX_AMD64=bf52519eb57f675d47c07d43213cb6dff6449f3d6d1147ff6701ed91f44eef0c
SYFT_SHA256_DARWIN_ARM64=e0a74a5d2688d1254b4e17b71f068a83215e3625f846265bf6614c7ba06f3a96
